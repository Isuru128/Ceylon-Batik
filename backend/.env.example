# --- Server Configuration ---
PORT=5000

# --- MongoDB Atlas Database Credentials ---
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-address>.mongodb.net/?appName=ceylonBatik
MONGODB_DATABASE=ceylonBatik

# --- JWT Authentication Secret ---
JWT_SECRET=your_jwt_secret_key_here

# --- Admin Account Credentials (used on first boot to create the admin account) ---
ADMIN_EMAIL=admin@ceylonbatik.lk
ADMIN_PASSWORD=your_secure_admin_password_here

# --- Serverless IDM-VTON GPU Endpoint (Modal.com / RunPod) ---
VTON_ENDPOINT_URL=https://<your-username>--ceylon-batik-vton-idmvtonworker-tryon.modal.run
VTON_API_KEY=optional_secret_token
